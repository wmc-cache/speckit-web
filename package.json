{
  "name": "speckit-web",
  "version": "0.1.0",
  "description": "Browse, publish and initialize GitHub Spec Kit projects in the browser.",
  "keywords": [
    "spec-kit",
    "speckit",
    "spec-driven-development",
    "documentation",
    "viewer",
    "cli"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "speckit-web": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speckit-web/speckit-web.git"
  },
  "homepage": "https://github.com/speckit-web/speckit-web#readme",
  "bugs": "https://github.com/speckit-web/speckit-web/issues",
  "scripts": {
    "dev": "tsx src/cli/index.ts serve examples/demo-project --no-open",
    "dev:web": "vite",
    "build": "vite build && tsup",
    "test": "vitest run --project unit --project integration",
    "test:perf": "vitest run --project perf",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "format": "prettier --write .",
    "sync-integrations": "tsx scripts/sync-integrations.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "check-size": "tsx scripts/check-size.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.5",
    "@shikijs/rehype": "^4.5.0",
    "cac": "^7.1.0",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "github-slugger": "^2.0.0",
    "hono": "^4.13.13",
    "mdast-util-to-string": "^4.0.0",
    "open": "^11.0.4",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mermaid": "^12.2.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve": "^14.2.6",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wouter": "^3.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
